# OAuth web-client ID used only when the user enables Google Drive sync.
# scatter.study and the documented local ports use Scatter's shared public
# client automatically; set this for a self-hosted deployment on another origin.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
# Optional Picker overrides for self-hosted deployments on origins other than
# scatter.study and the documented local development ports.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=
